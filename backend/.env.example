FLASK_ENV=development
FLASK_PORT=5000
PORT=5000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# openai_compatible：请求 ${AI_BASE_URL}/chat/completions
AI_PROVIDER=openai_compatible
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# 知乎 Access Secret 只能保存在后端环境变量中
ZHIHU_API_KEY=
ZHIHU_BASE_URL=https://developer.zhihu.com

# Demo 默认使用明确标识的 mock；接入凭证后设为 false。
USE_MOCK_AI=true
USE_MOCK_ZHIHU=true
CACHE_TTL_SECONDS=1800

# Optional Jiayan model directory. It must contain jiayan.klm, pos_model,
# cut_model and punc_model downloaded from the upstream Jiayan model release.
JIAYAN_MODEL_DIR=
